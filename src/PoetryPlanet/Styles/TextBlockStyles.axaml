<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <StackPanel Margin="20" Height="300" Width="300">
                <TextBlock Classes="H1" Text="标题一 Head 1"></TextBlock>
                <TextBlock Classes="H2" Text="标题二 Head 2"></TextBlock>
                <TextBlock Classes="H3" Text="标题三 Head 3"></TextBlock>
                <TextBlock Classes="Body" Text="正文 Body"></TextBlock>
        </StackPanel>
    </Design.PreviewWith>
    <Style Selector="TextBlock.H1">
        <Setter Property="FontSize" Value="20"></Setter>
        <Setter Property="FontWeight" Value="Normal"></Setter>
    </Style>
    <Style Selector="TextBlock.H2">
        <Setter Property="FontSize" Value="18"></Setter>
        <Setter Property="FontWeight" Value="Normal"></Setter>
    </Style>
    <Style Selector="TextBlock.H3">
        <Setter Property="FontSize" Value="17"></Setter>
        <Setter Property="FontWeight" Value="Normal"></Setter>
    </Style>
    <Style Selector="TextBlock.Body">
        <Setter Property="FontSize" Value="16"></Setter>
        <Setter Property="FontWeight" Value="Normal"></Setter>
    </Style>
    
    <Style Selector="SelectableTextBlock.H1">
        <Setter Property="FontSize" Value="20"></Setter>
        <Setter Property="FontWeight" Value="Normal"></Setter>
    </Style>
    <Style Selector="SelectableTextBlock.H2">
        <Setter Property="FontSize" Value="18"></Setter>
        <Setter Property="FontWeight" Value="Normal"></Setter>
    </Style>
    <Style Selector="SelectableTextBlock.H3">
        <Setter Property="FontSize" Value="17"></Setter>
        <Setter Property="FontWeight" Value="Normal"></Setter>
    </Style>
    <Style Selector="SelectableTextBlock.Body">
        <Setter Property="FontSize" Value="16"></Setter>
        <Setter Property="FontWeight" Value="Normal"></Setter>
    </Style>
</Styles>
