<UserControl
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="PoetryPlanet.Controls.FormFieldSwitch"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:PoetryPlanet.Controls">
    <UserControl.Styles>
        <Style Selector="controls|FormFieldSwitch">
            <Setter Property="Template">
                <ControlTemplate>
                    <DockPanel Height="47">
                        <ToggleButton
                            Classes="Switch"
                            DockPanel.Dock="Right"
                            HorizontalAlignment="Right"
                            IsChecked="{TemplateBinding IsChecked, Mode=TwoWay}" Margin="-14,0"
                            VerticalAlignment="Center" />
                        <TextBlock
                            FontWeight="DemiBold"
                            HorizontalAlignment="Left"
                            Text="{TemplateBinding Title}"
                            VerticalAlignment="Center" />
                    </DockPanel>
                </ControlTemplate>
            </Setter>
        </Style>
    </UserControl.Styles>
</UserControl>
