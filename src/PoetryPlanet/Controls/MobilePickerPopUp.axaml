<UserControl
    d:DesignHeight="450"
    d:DesignWidth="400"
    mc:Ignorable="d"
    x:Class="PoetryPlanet.Controls.MobilePickerPopUp"
    x:DataType="controls:MobilePickerPopUpViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:PoetryPlanet.Controls">
    <UserControl.DataContext>
        <controls:MobilePickerPopUpViewModel />
    </UserControl.DataContext>
    <Border Name="rootBorder" Width="300" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
            <TextBlock Text="{Binding Title}" FontWeight="Bold" Margin="8,5"/>
            <TextBlock Text="{Binding SubTitle}" FontSize="13" Margin="9,2" TextWrapping="Wrap" />
            <Grid Margin="10,20,10,18" VerticalAlignment="Center">
                <ListBox
                    ItemsSource="{Binding Items}"
                    SelectedItem="{Binding SelectedItem}"
                    MaxHeight="170" MinHeight="120" VerticalAlignment="Center" />
            </Grid>
            <Button Click="DoneClick" Content="完成"/>
        </StackPanel>
    </Border>
</UserControl>
