<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:PoetryPlanet.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="viewModels:WorkViewModel"
             x:Class="PoetryPlanet.Views.WorkView">
    <Design.DataContext>
        <viewModels:WorkViewModel></viewModels:WorkViewModel>
    </Design.DataContext>
    <Grid Background="{DynamicResource Background}">
        <ScrollViewer 
            VerticalScrollBarVisibility="Hidden" 
            Margin="0,0,0,40"
            Padding="5">
            <ScrollViewer.GestureRecognizers>
                <ScrollGestureRecognizer 
                    CanHorizontallyScroll="True"
                    CanVerticallyScroll="True"/>
            </ScrollViewer.GestureRecognizers>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <SelectableTextBlock 
                    Text="{Binding Title}" 
                    FontSize="24" 
                    FontWeight="Bold" 
                    TextAlignment="Center" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center"
                    />
                <SelectableTextBlock 
                    Text="{Binding Author}"
                    TextWrapping="Wrap" 
                    FontSize="20" 
                    FontWeight="Bold" 
                    TextAlignment="Center"
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center"
                    Margin="10"/>
                <TextBlock 
                    Text="{Binding Content}" 
                    FontSize="18" 
                    FontWeight="Medium"
                    TextWrapping="Wrap" 
                    TextAlignment="Center"
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center"
                    Margin="10"/>
                <TextBlock 
                    Text="{Binding Intro}" 
                    FontSize="16"
                    TextWrapping="Wrap" 
                    TextAlignment="Center"
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center"
                    Margin="10"/>
            </StackPanel>
        </ScrollViewer>
        <Button 
            Margin="2"
            Content="返回" 
            VerticalAlignment="Bottom"
            Classes="Secondary"
            Command="{Binding GoBackCommand}"/>
    </Grid>
</UserControl>
