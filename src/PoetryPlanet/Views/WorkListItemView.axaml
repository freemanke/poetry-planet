<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:PoetryPlanet.ViewModels"
             xmlns:cherylUi="clr-namespace:CherylUI;assembly=CherylUI"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="viewModels:WorkListItemViewModel"
             x:Class="PoetryPlanet.Views.WorkListItemView">
    <Design.DataContext>
        <viewModels:WorkListItemViewModel />
    </Design.DataContext>
        <StackPanel Tapped="InputElement_OnTapped">
            <Grid Background="{DynamicResource Background}">
                <SelectableTextBlock Padding="4"
                    FontSize="16" 
                    FontWeight="Bold" 
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left" 
                    Text="{Binding Title}" />
                <SelectableTextBlock Padding="4"
                    Text="{Binding AuthorAndDynasty}" 
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right" />
            </Grid>
            <StackPanel Orientation="Horizontal">
                <TextBlock 
                    Padding="2"
                    FontSize="14" 
                    FontWeight="Light" 
                    TextWrapping="NoWrap"
                    Text="{Binding Content}" 
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"/>
            </StackPanel>
            <cherylUi:HorizontalSeparator />
        </StackPanel>
</UserControl>
