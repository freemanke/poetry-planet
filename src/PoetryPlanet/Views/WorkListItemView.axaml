<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:PoetryPlanet.ViewModels"
             xmlns:cherylUi="clr-namespace:CherylUI;assembly=CherylUI"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="viewModels:WorkListItemViewModel"
             x:Class="PoetryPlanet.Views.WorkListItemView">
    <Design.DataContext>
        <viewModels:WorkListItemViewModel />
    </Design.DataContext>
    <StackPanel Tapped="InputElement_OnTapped" Background="White">
        <Grid>
                   <TextBlock 
                       Text="{Binding Title}" 
                       Padding="4"
                       FontSize="16" 
                       FontWeight="Bold" 
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left" />
                   <TextBlock 
                       Text="{Binding AuthorAndDynasty}" 
                       Padding="4"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right" />
               </Grid>
        <Grid>
           <TextBlock 
               Padding="2"
               FontSize="14" 
               FontWeight="Light" 
               TextWrapping="NoWrap"
               Text="{Binding Content}" 
               HorizontalAlignment="Left"
               VerticalAlignment="Center"/>
       </Grid>
       <cherylUi:HorizontalSeparator />
    </StackPanel>
</UserControl>
