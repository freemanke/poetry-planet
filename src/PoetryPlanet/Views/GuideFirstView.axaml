<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:PoetryPlanet.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="vm:MainViewModel"
             x:Class="PoetryPlanet.Views.GuideFirstView">
    <StackPanel Spacing="5" Orientation="Vertical" Background="{DynamicResource Background}">
        <TextBlock
            HorizontalAlignment="Center"
            Text="{Binding FirstTitle}" />
        <Button
            Command="{Binding OpenNextViewCommand}"
            Margin="20">
            <TextBlock Text="打开第二视图" />
        </Button> 
        <Button
            Command="{Binding OpenNavigationViewCommand}"
            Margin="20">
            <TextBlock Text="打开导航视图" />
        </Button>
    </StackPanel>
</UserControl>
