<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:PoetryPlanet.ViewModels"
             xmlns:views="clr-namespace:PoetryPlanet.Views"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="500"
             x:DataType="viewModels:CollectionListViewModel"
             x:Class="PoetryPlanet.Views.CollectionListView">
    <Design.DataContext>
        <viewModels:CollectionListViewModel/>
    </Design.DataContext>
    <Grid Background="{DynamicResource Background}">
        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Orientation="Horizontal">
            <TextBox Classes=""
                Text="{Binding Keyword, Mode=TwoWay}" 
                Margin="10" TextChanged="OnTextChanged" MinWidth="300"
                HorizontalAlignment="Stretch" 
                VerticalAlignment="Center"
                Watermark="输入关键字进行搜索..."/>
        </StackPanel>
        <ScrollViewer Margin="0,48,0,0" VerticalScrollBarVisibility="Hidden">
            <!-- 使用 Avalonia.Controls.ItemsRepeater 内置的 Virtualization 实现高性能的列表渲染 -->
            <ItemsRepeater ItemsSource="{Binding List}">
                <ItemsRepeater.Layout>
                    <StackLayout />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate DataType="viewModels:CollectionListItemViewModel">
                        <views:CollectionListItemView/>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</UserControl>
