<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:PoetryPlanet.ViewModels"
             xmlns:views="clr-namespace:PoetryPlanet.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="viewModels:WorkListViewModel"
             x:Class="PoetryPlanet.Views.WorkListView">
    <ScrollViewer VerticalScrollBarVisibility="Hidden" Margin="0,0,0,40">
        <StackPanel>
            <ItemsControl ItemsSource="{Binding Works}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="viewModels:WorkListItemViewModel">
                       <views:WorkListItemView Margin="5,5,5,0"></views:WorkListItemView>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="加载数据" Command="{Binding LoadWorksCommand}"></Button>
        </StackPanel>
    </ScrollViewer>
</UserControl>
