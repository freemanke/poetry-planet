<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:PoetryPlanet.ViewModels"
             xmlns:controls="clr-namespace:PoetryPlanet.Controls"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="500"
             x:DataType="viewModels:MineViewModel"
             x:Class="PoetryPlanet.Views.MineView">
    <ScrollViewer VerticalScrollBarVisibility="Hidden" Margin="0,0,0,40">
        <StackPanel>
            <TextBlock FontSize="20" FontWeight="Light" TextAlignment="Center" Text="我的信息" Margin="10"></TextBlock>
            <controls:GlassCard Margin="5">
                <TextBlock Text="个人信息" HorizontalAlignment="Center"></TextBlock>
            </controls:GlassCard>
            <controls:GlassCard Margin="5">
                <StackPanel Spacing="5" Orientation="Horizontal">
                    <Button Content="显示对话框" Command="{Binding ShowDialogCommand}"></Button>
                    <Button Content="显示提示框" Command="{Binding ShowToastCommand}"></Button>
                </StackPanel>
            </controls:GlassCard>
        </StackPanel>
    </ScrollViewer>
</UserControl>
