<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:PoetryPlanet.ViewModels"
             xmlns:controls="clr-namespace:PoetryPlanet.Controls"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="500"
             x:DataType="viewModels:CollectionListItemViewModel"
             x:Class="PoetryPlanet.Views.CollectionListItemView">
    <Design.DataContext>
        <viewModels:CollectionListItemViewModel />
    </Design.DataContext>
    <StackPanel>
        <controls:FormFieldAction FontSize="18" FontWeight="Normal"
            Title="{Binding Title}" 
            Command="{Binding ShowCollectionCommand}"/>
        <controls:HorizontalSeparator/>
    </StackPanel>
</UserControl>
